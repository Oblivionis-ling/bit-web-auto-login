<Window x:Class="BITWebManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BIT-Web 自动登录"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        Icon="Resources/BITWebManager.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="{StaticResource WindowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Grid MaxWidth="1000" Margin="32,26,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BIT-Web 自动登录" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="北京理工大学校园网自动登录管理器"
                                   Margin="0,5,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="12,5"
                            VerticalAlignment="Top"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <TextBlock Text="{Binding ManagerVersionDisplay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Padding="22,18"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="#D7E9F7"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="0,2,16,0"
                                 VerticalAlignment="Top"
                                 Fill="{Binding OverallTone, Converter={StaticResource ToneToBrushConverter}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding OverallTitle}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OverallDetail}"
                                       Margin="0,6,12,0"
                                       FontSize="13.5"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OperationMessage}"
                                       Margin="0,6,12,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding BusyVisibility}" />
                            <TextBlock Text="{Binding FeedbackMessage}"
                                       Margin="0,6,12,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding FeedbackTone, Converter={StaticResource ToneToBrushConverter}}"
                                       Visibility="{Binding FeedbackVisibility}" />
                        </StackPanel>
                        <ProgressBar Grid.Column="2"
                                     Width="72"
                                     Height="4"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Visibility="{Binding BusyVisibility}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="420" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="3*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="安装状态" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}" Padding="20,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="58" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="自动登录" VerticalAlignment="Center" FontSize="13.5" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{Binding TaskTone, Converter={StaticResource ToneToBrushConverter}}" />
                                    <TextBlock Text="{Binding TaskValue}" FontSize="13.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" />

                                <TextBlock Grid.Row="2" Text="校园网账号" VerticalAlignment="Center" FontSize="13.5" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{Binding AccountTone, Converter={StaticResource ToneToBrushConverter}}" />
                                    <TextBlock Text="{Binding AccountValue}" FontSize="13.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" />

                                <TextBlock Grid.Row="4" Text="安装目录" VerticalAlignment="Center" FontSize="13.5" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="{Binding InstallDirectory}"
                                           Margin="20,0,0,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           MaxWidth="310"
                                           FontSize="12.5"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding InstallDirectory}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="高级" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Button Content="卸载自动登录"
                                            Command="{Binding UninstallCommand}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                    <TextBlock Text="保留账号与设置"
                                               Margin="2,6,2,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Button Content="清除账号信息"
                                            Command="{Binding ClearCredentialCommand}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                    <TextBlock Text="停用任务并清除凭据"
                                               Margin="2,6,2,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="快速操作" Style="{StaticResource SectionTitleStyle}" />
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                            <StackPanel>
                                <Button Command="{Binding PrimaryActionCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}">
                                    <TextBlock Text="{Binding PrimaryActionText}" Foreground="White" />
                                </Button>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="刷新状态"
                                            Command="{Binding RefreshStatusCommand}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Padding="8,0" />
                                    <Button Grid.Column="2"
                                            Content="打开目录"
                                            Command="{Binding OpenInstallDirectoryCommand}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Padding="8,0" />
                                </Grid>
                                <Button Content="{Binding AccountActionText}"
                                        Command="{Binding RefreshCredentialCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,10,0,0" />
                                <Button Content="修复安装"
                                        Command="{Binding RepairCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding InstalledVisibility}" />
                                <TextBlock Text="仅在点击时连接官方 GitHub Release"
                                           Margin="0,12,0,0"
                                           FontSize="12.5"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock Text="最近活动" Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource CardStyle}" Padding="20,16">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="3,5,15,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding Tone, Converter={StaticResource ToneToBrushConverter}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander x:Name="ErrorDetailsExpander"
                                      Header="查看技术详情"
                                      Margin="28,12,0,0"
                                      Visibility="{Binding ErrorVisibility}"
                                      Foreground="{StaticResource MutedTextBrush}">
                                <Border Margin="0,8,0,0" Padding="12" Background="{StaticResource TrustBrush}" CornerRadius="6">
                                    <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="Consolas"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             MaxHeight="120"
                                             VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,18,0,0"
                        Padding="16,12"
                        Background="{StaticResource TrustBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="15"
                              Height="17"
                              Margin="0,0,10,0"
                              Fill="{StaticResource MutedTextBrush}"
                              Stretch="Uniform"
                              Data="M8,0 C4.5,2 2,2.4 2,2.4 V8.2 C2,12.3 4.5,15.2 8,17 C11.5,15.2 14,12.3 14,8.2 V2.4 C14,2.4 11.5,2 8,0 M8,2.1 C9.9,3 11.4,3.3 12,3.5 V8.2 C12,11.1 10.4,13.2 8,14.7 C5.6,13.2 4,11.1 4,8.2 V3.5 C4.6,3.3 6.1,3 8,2.1 Z" />
                        <TextBlock Grid.Column="1"
                                   Text="凭据使用 Windows DPAPI 保存。BIT-Web 不读取或显示保存的密码。BIT-Web 不修改网络适配器。"
                                   FontSize="12.5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
